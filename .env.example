# Twilio Credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Flask
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True

# Ngrok (opcional - URL pública para webhook)
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Claude AI (opcional - para extração inteligente de OCR)
# Usa Claude Haiku (modelo mais barato: ~$0.002 por documento)
# Se não configurar, o sistema funciona sem IA (dados manuais)
ANTHROPIC_API_KEY=your_api_key_here
